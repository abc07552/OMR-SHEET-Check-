# Copy to .env on your OWN host. Never commit actual secrets. No variable in
# this file should use a VITE_ prefix: VITE_* values are public browser bundles.
# See documentation/DEPLOYMENT.md and documentation/TESTING.md.

# Local Python development: a SEPARATE .data/enterprise.sqlite when URL is empty.
APP_ENV=development
DATA_DIR=./.data
DATABASE_URL=
AUTO_MIGRATE=true
# STATIC_DIR=./dist

# Production requires a PostgreSQL URL, a stable Fernet key and an HTTPS URL.
# Generate with: .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Save the generated key securely; loss means encrypted originals cannot be read.
BACKUP_KEY=
PUBLIC_APP_URL=
# Exact optional alternate frontend origin; leave empty for same-origin hosting.
PUBLIC_WEB_ORIGIN=
# Random first-admin bootstrap secret. Remove it after successful setup.
SETUP_TOKEN=

# deployment/compose.yaml overrides the local settings above with production
# values. Use your REAL DNS domain and email; DNS/ports 80+443 must reach the host.
APP_DOMAIN=
ACME_EMAIL=
# Separate URL-safe random secrets; e.g. secrets.token_hex(32), not real examples.
# POSTGRES_PASSWORD is for the non-superuser application role.
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=

# Optional SMTP recovery delivery. STARTTLS is required by the application.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional private S3-compatible storage. Empty bucket => encrypted local objects.
# Prefer workload IAM roles. If required, inject narrowly scoped credentials on
# the server only. Do NOT expose keys or the bucket as a public file service.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Preserved Node baseline only (npm run server). It uses markly.sqlite and is
# not the enterprise Python service. Never use its DB as a Python destination.
NODE_ENV=development
PORT=3001
