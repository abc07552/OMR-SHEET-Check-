# Local development. Do not commit your actual .env file.
NODE_ENV=development
PORT=3001
DATA_DIR=./.data

# REQUIRED for first-run setup in production. Generate a long random value on
# your server, enter it in the first-administrator screen, and remove it after
# setup. Never put it in VITE_* variables (those are public browser bundles).
SETUP_TOKEN=

# Optional: exact HTTPS frontend origin when frontend and API are hosted
# separately. Leave empty for the recommended same-origin Node deployment.
PUBLIC_WEB_ORIGIN=

# Optional build-time API endpoint for a separately hosted frontend:
# VITE_API_BASE=https://your-api-host.example/api
# For a GitHub Pages frontend, set this when running npm run build:pages.
# Cross-site cookies may be blocked by browsers; same-origin hosting is preferred.
